# Copy this file to .env and fill in your key.
# Free FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- server -----------------------------------------------------------------
NEXFIREMAP_HOST=127.0.0.1
NEXFIREMAP_PORT=8000

# --- cache ------------------------------------------------------------------
# How many days of history to keep. Anything older is purged hourly.
NEXFIREMAP_CACHE_DAYS=30
# Where the SQLite cache lives.
NEXFIREMAP_DB=data/nexfiremap.sqlite3
# Datasets to pull, comma separated. Options:
#   VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, VIIRS_SNPP_NRT, MODIS_NRT, LANDSAT_NRT
NEXFIREMAP_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT,MODIS_NRT

# --- freshness --------------------------------------------------------------
# The most recent N days keep receiving detections, so they expire quickly.
# Satellites only revisit a given spot every couple of hours and FIRMS NRT
# processing itself lags ~3h, so there is little point polling much faster
# than that - these defaults are deliberately gentle on the FIRMS API.
NEXFIREMAP_HOT_DAYS=2
NEXFIREMAP_HOT_TTL_MINUTES=45
# How often cached regions are re-checked for new detections.
NEXFIREMAP_REFRESH_MINUTES=30

# --- fetching ---------------------------------------------------------------
# Days per FIRMS request. Confirmed live: NRT endpoints reject anything over
# 5 ("Invalid day range. Expects [1..5]") - lowered further automatically if
# a given source turns out even stricter.
NEXFIREMAP_MAX_DAY_RANGE=5
# Coverage grid size in degrees. Clamped to [0.5, 45].
NEXFIREMAP_CELL_SIZE_DEG=10
# Above this many grid cells, a single whole-world request is used instead.
NEXFIREMAP_MAX_CELLS=64
NEXFIREMAP_MAX_CONCURRENT_FETCHES=3
# Per-request timeout, in seconds. Clamped to [5, 600].
NEXFIREMAP_TIMEOUT_S=90

# --- basemap tile cache ------------------------------------------------------
# Every map tile (OSM and the other basemaps) is proxied through the server
# and saved to disk here, so panning back over an area costs no repeat
# download - even offline, already-viewed tiles keep working.
NEXFIREMAP_TILE_DIR=data/tiles
# How long a tile is trusted before it's considered stale and re-fetched.
NEXFIREMAP_TILE_CACHE_DAYS=30
# Total size budget for the tile cache; oldest tiles are evicted first once
# this is exceeded, so disk usage stays "cached to an extent", not unbounded.
NEXFIREMAP_TILE_CACHE_MAX_MB=1024
NEXFIREMAP_TILE_MAX_CONCURRENT=8
# Optional contact info added to the tile-fetch User-Agent, per OSM's tile
# usage policy (https://operations.osmfoundation.org/policies/tiles/).
# NEXFIREMAP_CONTACT=you@example.com

# --- background compute jobs --------------------------------------------------
# Event clustering, likelihood rasters, burn-scar imagery and physics
# propagation all run through this queue, in separate idle-OS-priority
# processes (see nexfiremap/jobs.py) - they never block the API or eat CPU
# that something else on the machine wants.
NEXFIREMAP_JOB_DIR=data/jobs
# 0 = auto (cpu_count - 1, minimum 1).
NEXFIREMAP_JOB_WORKERS=0
# Finished job rows/output files older than this are cleaned up hourly.
NEXFIREMAP_JOB_RETENTION_DAYS=14
# A job (stalled network call, pathological input) running longer than this
# is abandoned and reported as an error instead of occupying a worker slot
# forever. Clamped to [30, 86400].
NEXFIREMAP_JOB_TIMEOUT_S=1800

# --- verified operational backups ------------------------------------------
# SQLite online backups are integrity-checked before atomic publication.
NEXFIREMAP_BACKUP_DIR=data/backups
# 0 disables scheduled backups; the manual backup button remains available.
NEXFIREMAP_BACKUP_INTERVAL_MINUTES=15
NEXFIREMAP_BACKUP_KEEP=24

# Field observations older than this remain visible but are marked stale.
NEXFIREMAP_OBSERVATION_STALE_HOURS=6

# --- incident-LAN vehicle telemetry and drone evidence ---------------------
# These thresholds label derived display results; raw observations remain.
NEXFIREMAP_POSITION_STALE_SECONDS=300
NEXFIREMAP_POSITION_MAX_SPEED_KMH=180
NEXFIREMAP_TELEMETRY_MAX_BATCH=1000
NEXFIREMAP_TELEMETRY_REQUESTS_PER_MINUTE=120
# Originals/previews are stored here; georeferenced derivatives live beneath
# NEXFIREMAP_TILE_DIR/offline_sources. Both directories accompany the DB at handover.
NEXFIREMAP_DRONE_DIR=data/drone
NEXFIREMAP_DRONE_MAX_UPLOAD_MB=200
NEXFIREMAP_DRONE_MAX_PIXELS=200000000
NEXFIREMAP_DRONE_MOSAIC_MAX_PIXELS=100000000

# Explicit incident-LAN mode. The default loopback server needs no login.
# LAN mode fails closed unless the password is at least 12 characters.
NEXFIREMAP_LAN_MODE=false
NEXFIREMAP_ADMIN_PASSWORD=
NEXFIREMAP_SESSION_MINUTES=30
# Optional PEM certificate and private key for direct HTTPS. Both are required
# together. Every field device must trust the certificate before deployment.
NEXFIREMAP_TLS_CERT_FILE=
NEXFIREMAP_TLS_KEY_FILE=

# --- optional warm start ----------------------------------------------------
# Pre-cache a region on startup, e.g. Europe:
# NEXFIREMAP_STARTUP_BBOX=-11,35,40,60
# NEXFIREMAP_STARTUP_DAYS=30

# --- EUMETSAT (optional European corroboration source) -----------------------
# Free account + API key: https://api.eumetsat.int/api-key/
# Only the consumer key/secret are stored - they're durable, and the server
# exchanges them for a short-lived (~24h) access token itself on each use
# (POST https://api.eumetsat.int/token, client_credentials grant), the same
# exchange documented at that link, rather than storing a token that would
# just go stale.
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
